# Copy to .env and fill in. Never commit .env.
# Used by `npm run dev` (via node --env-file) and by docker compose.

NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/streamify

# Redis is optional. Leave empty to disable caching entirely; if Redis is set but
# unreachable, the API keeps working without the cache.
REDIS_URL=redis://127.0.0.1:6379

# REQUIRED: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars

# Session lifetime in seconds (default 7 days)
JWT_EXPIRES_IN_SEC=604800

# Comma-separated browser origins allowed by CORS/Socket.IO
CLIENT_ORIGIN=http://localhost:5173

# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
# COOKIE_SECURE=false

LOG_LEVEL=info

# Where generated demo audio is stored (relative to server/)
AUDIO_DIR=storage/audio

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
